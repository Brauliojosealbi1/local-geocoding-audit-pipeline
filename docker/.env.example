# ==============================================================================
# INFRAESTRUCTURA GEOESPACIAL LOCAL (NOMINATIM + POSTGIS)
# Plantilla de Configuración de Variables de Entorno (.env.example)
# Subdirección de Estadísticas y Estudios - Superintendencia de Bancos
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IMAGEN Y PUERTO DE RED
# ------------------------------------------------------------------------------
# Imagen base optimizada de Nominatim (PostgreSQL 16 + PostGIS 3.4)
NOMINATIM_IMAGE=mediagis/nominatim:4.4

# Puerto en el host anfitrión para exponer la API REST local de geocodificación
NOMINATIM_PORT=8080

# ------------------------------------------------------------------------------
# 2. INSUMO CARTOGRÁFICO VECTORIAL (OPENSTREETMAP)
# ------------------------------------------------------------------------------
# URL del repositorio Geofabrik para el extracto geográfico PBF oficial
OSM_PBF_URL=https://download.geofabrik.de/south-america/ecuador-latest.osm.pbf

# Nombre del archivo binario .osm.pbf almacenado en el volumen persistente ./data
PBF_FILENAME=ecuador-latest.osm.pbf

# ------------------------------------------------------------------------------
# 3. OPTIMIZACIÓN DE RECURSOS DEL MOTOR POSTGRESQL / OSM2PGSQL
# Ajustes recomendados para estaciones con 16 GB a 64 GB de memoria RAM
# ------------------------------------------------------------------------------
# Memoria compartida asignada a la base de datos interna de Nominatim
POSTGRES_SHARED_BUFFERS=4GB

# Memoria de trabajo para indexación espacial intensiva GiST durante la carga inicial
POSTGRES_MAINTENANCE_WORK_MEM=8GB

# Memoria asignada a operaciones de ordenamiento y filtrado por consulta
POSTGRES_WORK_MEM=128MB

# Hilos de procesamiento en paralelo asignados a la compilación cartográfica
THREADS=8